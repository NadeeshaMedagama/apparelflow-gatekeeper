{
  "name": "apparelflow-erp",
  "version": "1.0.0",
  "description": "ApparelFlow ERP — Cutting Operations & Gatekeeper Verification Terminal with a server-enforced sewing queue gate.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "audit:api": "node scripts/audit-api.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "docker:db": "docker compose -f docker/compose.yaml up -d db",
    "docker:build": "docker build -f docker/Dockerfile -t apparelflow-erp ."
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.3",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "18.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
