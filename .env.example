# -----------------------------------------------------------------------------
# ApparelFlow ERP — environment template
# Copy to `.env` for local development (see docs/local-development.md).
# Vercel + Neon setup (which keys go where): docs/deployment.md.
# -----------------------------------------------------------------------------

# Runtime database connection (PostgreSQL).
#  - Local, password auth (e.g. npm run docker:db):
#              postgresql://postgres:postgres@localhost:5432/apparelflow?schema=public
#  - Local, Homebrew / Postgres.app (OS user, no password):
#              postgresql://<your-os-username>@localhost:5432/apparelflow?schema=public
#  - Neon:     the *pooled* connection string (host contains "-pooler"), plus
#              &pgbouncer=true&connection_limit=1&connect_timeout=15
#  - Supabase: the transaction pooler (port 6543), plus  ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apparelflow?schema=public"

# Direct (non-pooled) connection used by `prisma migrate`.
# Locally this is usually identical to DATABASE_URL.
#  - Neon:     the *direct* connection string (no "-pooler" in the host), plus  &connect_timeout=15
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apparelflow?schema=public"

# Secret used to sign session tokens (HS256). At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# Integration tests only: a PostgreSQL connection the test runner may use to
# create and drop throw-away databases (the role needs CREATEDB).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apparelflow_test?schema=public"

# Optional: IANA time zone used to display plant timestamps (default Asia/Colombo).
NEXT_PUBLIC_PLANT_TIMEZONE="Asia/Colombo"
